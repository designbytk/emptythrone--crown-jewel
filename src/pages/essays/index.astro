---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import { getAllPosts } from "../../lib/posts";

const posts = getAllPosts().filter((post) => post.kind === "essay");
---

<BaseLayout
  title="Essays — Emptythrone"
  description="Longer, worked-through pieces."
>
  <Header />
  <main>
    <ArchiveList heading="Essays" posts={posts} />
  </main>
  <Footer />
</BaseLayout>
