---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import { getAllPosts } from "../../lib/posts";

const posts = getAllPosts().filter((post) => post.kind === "link");
---

<BaseLayout
  title="Links — Emptythrone"
  description="Things worth reading elsewhere."
>
  <Header />
  <main>
    <ArchiveList heading="Links" posts={posts} />
  </main>
  <Footer />
</BaseLayout>
