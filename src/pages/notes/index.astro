---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import { getAllPosts } from "../../lib/posts";

const posts = getAllPosts().filter((post) => post.kind === "note");
---

<BaseLayout
  title="Notes — Emptythrone"
  description="Shorter, unfinished thoughts."
>
  <Header />
  <main>
    <ArchiveList heading="Notes" posts={posts} />
  </main>
  <Footer />
</BaseLayout>
